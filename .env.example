# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git, so your real key never gets committed.

# Required: create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: which OpenAI model to use (defaults to gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini
